datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  sapUserId    String   @unique
  name         String
  email        String?  @unique
  role         String   // "directora" | "consultora"
  unitName     String?  // Nombre de la unidad (solo directoras)
  isSuperAdmin  Boolean  @default(false)
  localPassword String?  // Hash bcrypt — solo para usuarios del sistema (no SAP)

  // Jerarquía directora → consultoras / directora → directora madre
  supervisorId String?
  supervisor   User?    @relation("Supervision", fields: [supervisorId], references: [id])
  subordinates User[]   @relation("Supervision")

  // Iniciadora: quién reclutó personalmente a esta persona (U_CodIni de SAP)
  // Puede ser distinta a la directora de la unidad
  inciadoraId  String?
  iniciadora   User?    @relation("Iniciadora", fields: [inciadoraId], references: [id])
  reclutas     User[]   @relation("Iniciadora")

  sales        Sale[]
  targets      Target[]
  creditNotes  CreditNote[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastSapSync  DateTime?

  // DIQ relations
  diqAsCandidate DIQ?    @relation("DIQCandidate")
  diqsRegistered DIQ[]   @relation("DIQRegisteredBy")

  @@index([sapUserId])
  @@index([supervisorId])
  @@index([inciadoraId])
  @@map("users")
}

// Candidata a Directora en Calificación (DIQ)
model DIQ {
  id             String    @id @default(cuid())

  // La consultora/iniciadora que está calificando
  userId         String    @unique
  user           User      @relation("DIQCandidate", fields: [userId], references: [id])

  // Quién la registró (directora o superadmin)
  registeredById String
  registeredBy   User      @relation("DIQRegisteredBy", fields: [registeredById], references: [id])

  // Período de calificación (3 meses desde startDate)
  startDate      DateTime
  endDate        DateTime  // startDate + 3 meses

  // Estado
  status         String    @default("active") // "active" | "completed" | "failed"
  completedAt    DateTime?

  // Metas fijas
  targetConsultoras  Int     @default(24)
  targetProduccion   Decimal @default(300000) @db.Decimal(18, 2)
  targetIniciaciones Int     @default(8)

  // Notas opcionales
  notes          String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([registeredById])
  @@index([status])
  @@map("diqs")
}

model Sale {
  id         String   @id @default(cuid())
  sapOrderId String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [sapUserId])
  amount     Decimal  @db.Decimal(18, 2)
  currency   String   @default("DOP")
  saleDate   DateTime
  status     String   @default("completed")
  sapDocNum  Int?
  sapDocEntry String
  syncedAt   DateTime @default(now())

  @@index([userId])
  @@index([saleDate])
  @@map("sales")
}

model Target {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [sapUserId])
  month        Int
  year         Int
  targetAmount Decimal  @db.Decimal(18, 2)
  currency     String   @default("DOP")
  sapReference String?
  syncedAt     DateTime @default(now())

  @@unique([userId, month, year])
  @@index([userId])
  @@map("targets")
}


// Nota de credito (sincronizada de SAP)
model CreditNote {
  id          String   @id @default(cuid())
  sapDocEntry String   @unique  // DocEntry de SAP
  sapDocNum   Int
  userId      String               // CardCode -> mapea a User.sapUserId
  user        User     @relation(fields: [userId], references: [sapUserId])

  amount      Decimal  @db.Decimal(18, 2)  // DocTotal bruto
  currency    String   @default("DOP")
  docDate     DateTime
  comments    String?
  ncfRef      String?  // U_NCF (factura afectada)
  ncfNC       String?  // U_NCF_NC (NCF de esta NC)
  cancelled   Boolean  @default(false)
  syncedAt    DateTime @default(now())

  @@index([userId])
  @@index([docDate])
  @@map("credit_notes")
}

model SyncLog {
  id               String    @id @default(cuid())
  syncType         String
  status           String
  recordsProcessed Int       @default(0)
  errorMessage     String?
  startedAt        DateTime  @default(now())
  completedAt      DateTime?

  @@index([syncType])
  @@index([startedAt])
  @@map("sync_logs")
}
